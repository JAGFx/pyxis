<div {{ attributes }} >
    <twig:Card color="transparent" size="lg" class="pt-1" >
        {{ form_start(form, { attr: { 'data-turbo': true } }) }}
        {{ form_errors(form) }}
        {{ form_row(form.status) }}
        {{ form_row(form.documentType) }}
        {{ form_row(form.startDate) }}
        {{ form_row(form.endDate) }}
        {% include 'shared/menu/_search_form_button_actions.html.twig' %}
        {{ form_end(form) }}
    </twig:Card>
</div>
