{% set frameId = 'exporter_artifact_list_item_' ~ artifact.id %}

{% if artifact.isFinished %}
    {% set statusLabel =  artifact.finishedAt | format_datetime(timeFormat='short', locale=app.request.locale) %}
{% elseif artifact.isDisabled %}
    {% set statusLabel =  artifact.disabledAt | format_datetime(timeFormat='short', locale=app.request.locale) %}
{% else %}
    {% set statusLabel =  artifact.status.label() %}
{% endif %}

<turbo-frame id="{{ frameId }}">
    <twig:Overlay:TriggerLongPress target="{{ frameId }}">
        <twig:List:Item>
            <div class="flex justify-between items-start">
                <span>{{ ('exporter.request_export.' ~ artifact.command) | trans }}</span>
                <twig:Tooltip title="{{ 'exporter.artifact.list.createdAt' | trans }}" placement="left" class="flex-none">
                    <small class="text-muted">{{ artifact.createdAt | format_datetime(timeFormat='short', locale=app.request.locale) }}</small>
                </twig:Tooltip>
            </div>

            <twig:block name="detail">
                <div class="flex justify-start items-center space-x-2 mb-1">
                    <twig:List:EntityValueItem label="{{ statusLabel | trans }}" :color="artifact.status.color">
                        {{ artifact.status.label() | trans  }}
                    </twig:List:EntityValueItem>
                    {% if artifact.documentType %}
                        <twig:List:EntityValueItem label="{{ 'exporter.artifact.list.type' | trans }}" color="default">
                            {{ artifact.documentType.value | upper }}
                        </twig:List:EntityValueItem>
                    {% endif %}
                </div>
            </twig:block>
        </twig:List:Item>
    </twig:Overlay:TriggerLongPress>

    {% if is_granted(constant('App\\Module\\Exporter\\Domain\\Artifact\\Security\\ArtifactVoter::DOWNLOAD'), artifact) %}
        <twig:Overlay:Overlay id="{{ frameId }}">
            <twig:block name="sub_header">
                <h3 class="text-xl text-center p-2">{{ ('exporter.request_export.' ~ artifact.command) | trans }}</h3>
                <small class="text-muted text-center">{{ artifact.createdAt | format_datetime(timeFormat='short', locale=app.request.locale) }}</small>
                {% if artifact.documentType %}
                    <div class="flex items-center justify-center space-x-2">
                        <twig:List:EntityValueItem label="{{ 'exporter.artifact.list.type' | trans }}" color="default">
                            {{ artifact.documentType.value | upper }}
                        </twig:List:EntityValueItem>
                    </div>
                {% endif %}
            </twig:block>
            <div class="overlay-grid">
                <twig:Overlay:GridActionButton
                    actionUrl="{{ path('back_exporter_download_artifact', {'artifactUuid': artifact.uuid}) }}"
                    :icon="icons.download"
                    label="{{ 'actions.download' | trans(domain: 'interface') }}"
                />
            </div>
        </twig:Overlay:Overlay>
    {% endif %}
</turbo-frame>
